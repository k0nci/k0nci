---
import BaseLayout from '../layouts/BaseLayout.astro';
// import AuroraBackground from '../components/background/AuroraBackground.astro';
import TwinklingStars from '../components/background/TwinklingStars.astro';
import MountainLayers from '../components/background/MountainLayers.astro';
import HeroTitle from '../components/content/HeroTitle.astro';
import TechStack from '../components/content/TechStack.astro';
import ActivityIcons from '../components/content/ActivityIcons.astro';
import SocialLinks from '../components/content/SocialLinks.astro';
import { personalInfo, technologies, activities, socialLinks, seoStructuredData } from '../data/portfolioData';

const title = 'Matej Koncal | Personal Website';
const description = 'Software Engineer specializing in Backend, Cloud, and DevOps. Mountain enthusiast from Slovakia.';
---

<BaseLayout title={title} description={description} structuredData={seoStructuredData}>
  <div
    class="relative h-screen overflow-hidden font-sans text-white"
    style="background: linear-gradient(135deg, #2c3e50 0%, #4a69bd 20%, #3c6382 40%, #40739e 60%, #487eb0 80%, #5b73e8 100%);"
  >
    <!-- <AuroraBackground /> -->
    <TwinklingStars />
    <MountainLayers class="z-10" />
    <div class="relative z-20 flex h-full items-center justify-center">
      <div class="animate-fadeInUp px-4 text-center">
        <HeroTitle name={personalInfo.name} subtitle={personalInfo.subtitle} class="mb-14" />
        <TechStack technologies={technologies} class="mb-14" />
        <ActivityIcons activities={activities} class="mb-12" />
        <SocialLinks links={socialLinks} />
      </div>
    </div>

    <!-- Copyright notice -->
    <div class="absolute bottom-2 right-4 z-30">
      <p class="text-[0.5rem] text-white/60">Built by k0nci with AI help • 2025</p>
    </div>
  </div>
</BaseLayout>
